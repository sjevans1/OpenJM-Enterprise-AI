# OpenJM application state
OPENJM_DATABASE_URL=sqlite+aiosqlite:///./data/openjm.db
OPENJM_UPLOAD_DIR=./data/uploads

# OpenAI-compatible model endpoint.
# Validated local development target: Gemma 4 12B worker on port 18080.
# Hermes, Ollama and vLLM can also sit behind this interface.
OPENJM_MODEL_BASE_URL=http://127.0.0.1:18080/v1
OPENJM_MODEL_API_KEY=
OPENJM_MODEL_NAME=gemma-4-12b-local
OPENJM_MODEL_TIMEOUT_SECONDS=300

# DB-GPT-backed knowledge engine
OPENJM_KNOWLEDGE_ENABLED=true
OPENJM_VECTOR_PATH=./data/vector
OPENJM_VECTOR_COLLECTION=openjm_default
OPENJM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENJM_RAG_TOP_K=5
OPENJM_RAG_SCORE_THRESHOLD=0.25

# Development identity until enterprise auth is added
OPENJM_DEV_USER_ID=local-admin


# Structured data security
# Leave OPENJM_CREDENTIAL_ENCRYPTION_KEY empty for local development; OpenJM will
# create a repo-local key file under ./data/, which is gitignored.
# In managed deployments set a stable Fernet key through secret management.
OPENJM_CREDENTIAL_ENCRYPTION_KEY=
OPENJM_CREDENTIAL_KEY_FILE=./data/credentials.key
OPENJM_STRUCTURED_MAX_ROWS=200
OPENJM_STRUCTURED_TIMEOUT_SECONDS=20
