# OpenJM application state
OPENJM_DATABASE_URL=sqlite+aiosqlite:///./data/openjm.db
OPENJM_UPLOAD_DIR=./data/uploads

# OpenAI-compatible model endpoint.
# Hermes, Ollama and vLLM can all sit behind this interface.
OPENJM_MODEL_BASE_URL=http://127.0.0.1:8642/v1
OPENJM_MODEL_API_KEY=
OPENJM_MODEL_NAME=hermes-agent
OPENJM_MODEL_TIMEOUT_SECONDS=120

# DB-GPT-backed knowledge engine
OPENJM_KNOWLEDGE_ENABLED=true
OPENJM_VECTOR_PATH=./data/vector
OPENJM_VECTOR_COLLECTION=openjm_default
OPENJM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENJM_RAG_TOP_K=5
OPENJM_RAG_SCORE_THRESHOLD=0.25

# Development identity until enterprise auth is added
OPENJM_DEV_USER_ID=local-admin
