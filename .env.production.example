# OpenJM Enterprise AI — PRODUCTION configuration template (VS8).
#
# Copy to .env and replace every placeholder. Startup performs a fail-closed
# preflight (`python -m app.core.preflight`); it refuses to serve while an
# unsafe combination remains. No value here is a real secret.

# --- Profile and release identity ------------------------------------------
OPENJM_DEPLOYMENT_PROFILE=production
OPENJM_RELEASE_ID=
OPENJM_PRODUCT_NAME=OpenJM Enterprise AI
OPENJM_ORGANIZATION_NAME=
OPENJM_BROWSER_PAGE_TITLE=
OPENJM_SUPPORT_CONTACT=
# Optional brand/theme display metadata (text only; never raw HTML).
OPENJM_BRAND_LOGO_URL=
OPENJM_THEME_ACCENT=

# --- Identity (OIDC/SSO required in production) ----------------------------
OPENJM_AUTH_MODE=oidc
OPENJM_AUTH_ALLOW_DEV_MODE=false
OPENJM_OIDC_ISSUER=https://idp.example.com/realms/openjm
OPENJM_OIDC_CLIENT_ID=openjm
OPENJM_OIDC_CLIENT_SECRET=REPLACE_ME_WITH_A_REAL_SECRET
OPENJM_OIDC_REDIRECT_URI=https://openjm.example.com/auth/callback
OPENJM_OIDC_DISCOVERY_URL=https://idp.example.com/realms/openjm/.well-known/openid-configuration
OPENJM_OIDC_AUDIENCE=openjm
OPENJM_OIDC_JWKS_URL=
OPENJM_SESSION_TTL_SECONDS=28800

# --- Application-metadata database (PostgreSQL in production) --------------
# Compose renders OPENJM_DATABASE_URL from OPENJM_DB_PASSWORD and the secret
# file /run/secrets/openjm_db_password (see deploy/compose/docker-compose.prod.yml).
# Set the same value here and in that secret file; the standalone
# OPENJM_DATABASE_URL below is the non-Compose fallback.
OPENJM_DB_PASSWORD=REPLACE_ME
OPENJM_DATABASE_URL=postgresql+asyncpg://openjm:REPLACE_ME@db:5432/openjm

# --- Credential-vault key material -----------------------------------------
# Prefer a secret file with 0600 permissions over an inline value.
OPENJM_CREDENTIAL_ENCRYPTION_KEY=
OPENJM_CREDENTIAL_KEY_FILE=/etc/openjm/credentials.key

# --- Persistent storage ----------------------------------------------------
OPENJM_UPLOAD_DIR=/var/lib/openjm/uploads
OPENJM_VECTOR_PATH=/var/lib/openjm/vector
OPENJM_BACKUP_DIR=/var/backups/openjm

# --- Private model serving --------------------------------------------------
# 'private_remote' = operator-managed private OpenAI-compatible service.
# HTTPS is required; the credential is used server-side only and is never
# returned by any endpoint or sent to the browser.
OPENJM_MODEL_PROVIDER_MODE=private_remote
OPENJM_MODEL_BASE_URL=https://llm.internal.example.com/v1
OPENJM_MODEL_NAME=openjm-private-8b
OPENJM_MODEL_API_KEY=REPLACE_ME_WITH_THE_PROVIDER_CREDENTIAL
OPENJM_MODEL_TIMEOUT_SECONDS=120
# Fail closed: never silently fall back to a public provider.
OPENJM_MODEL_PROVIDER_FALLBACK=none

# --- Reverse proxy / TLS boundary and security ----------------------------
OPENJM_CORS_ORIGINS=https://openjm.example.com
OPENJM_TRUSTED_HOSTS=openjm.example.com
OPENJM_TRUST_PROXY_HEADERS=true
OPENJM_SECURITY_HEADERS_ENABLED=true
OPENJM_MAX_REQUEST_BODY_BYTES=8000000
OPENJM_MAX_UPLOAD_BYTES=25000000
OPENJM_RATE_LIMIT_ENABLED=true
OPENJM_RATE_LIMIT_EXPENSIVE_PER_MINUTE=60

# --- Knowledge engine ------------------------------------------------------
OPENJM_KNOWLEDGE_ENABLED=true
OPENJM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observability ---------------------------------------------------------
OPENJM_METRICS_ENABLED=true
OPENJM_SCHEDULER_ENABLED=true
OPENJM_SCHEDULER_TICK_SECONDS=30

# --- Retention (opt-in; audit/report/customer data are never eligible) ------
OPENJM_RETENTION_ENABLED=false
OPENJM_RETENTION_SESSIONS_DAYS=30
OPENJM_RETENTION_SCHEDULER_RUNS_DAYS=30
OPENJM_RETENTION_NOTIFICATION_HISTORY_DAYS=90
OPENJM_RETENTION_CONNECTOR_RUN_HISTORY_DAYS=30
