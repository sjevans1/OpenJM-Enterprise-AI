# OpenJM Enterprise AI - QA1 acceptance environment configuration template.
#
# NON-SECRET template. Copy nothing verbatim into source control: this file
# documents the accepted production profile used by QA1. Values marked SECRET are
# injected at runtime from the operator's secret store (see deploy/qa/README.md);
# they are never committed.
#
# Profile: production. The startup preflight (python -m app.core.preflight) is
# fail-closed, so a missing or unsafe value refuses to serve.

# --- Profile and release identity ------------------------------------------
OPENJM_DEPLOYMENT_PROFILE=production
OPENJM_RELEASE_ID=rel1-qa1
OPENJM_PRODUCT_NAME=OpenJM Enterprise AI
OPENJM_ORGANIZATION_NAME=OpenJM QA Acceptance

# --- Identity: real OIDC (Keycloak), no dev fallback ------------------------
OPENJM_AUTH_MODE=oidc
OPENJM_AUTH_ALLOW_DEV_MODE=false
OPENJM_OIDC_ISSUER=http://127.0.0.1:18090/realms/openjm
OPENJM_OIDC_DISCOVERY_URL=http://127.0.0.1:18090/realms/openjm/.well-known/openid-configuration
OPENJM_OIDC_CLIENT_ID=openjm
OPENJM_OIDC_AUDIENCE=openjm
OPENJM_OIDC_REDIRECT_URI=http://127.0.0.1:15173/auth/callback
OPENJM_OIDC_TENANT_CLAIM=tenant
OPENJM_TENANT_RESOLUTION=claim
OPENJM_SESSION_TTL_SECONDS=28800
# SECRET (injected): OPENJM_OIDC_CLIENT_SECRET

# --- Application-metadata database (PostgreSQL) ----------------------------
# QA1 uses the PostgreSQL container published on 127.0.0.1:15432.
# SECRET (injected): the password inside OPENJM_DATABASE_URL
OPENJM_DATABASE_URL=postgresql+asyncpg://openjm:${OPENJM_QA_DB_PASSWORD}@127.0.0.1:15432/openjm

# --- Credential-vault key material -----------------------------------------
# SECRET (injected): OPENJM_CREDENTIAL_ENCRYPTION_KEY (Fernet key)

# --- Persistent storage (outside the repository) ---------------------------
OPENJM_UPLOAD_DIR=${OPENJM_QA_ENV_ROOT}/runtime/uploads
OPENJM_VECTOR_PATH=${OPENJM_QA_ENV_ROOT}/runtime/vector
OPENJM_BACKUP_DIR=${OPENJM_QA_ENV_ROOT}/runtime/backups
OPENJM_CREDENTIAL_KEY_FILE=${OPENJM_QA_ENV_ROOT}/runtime/credentials.key
OPENJM_ARTIFACT_DIR=${OPENJM_QA_ENV_ROOT}/runtime/artifacts

# --- Model serving: approved local OpenAI-compatible endpoint --------------
# The accepted dev/QA path is a local OpenAI-compatible server. Production
# permits mode=local; plain HTTP is refused only for mode=private_remote.
OPENJM_MODEL_PROVIDER_MODE=local
OPENJM_MODEL_BASE_URL=http://127.0.0.1:18080/v1
OPENJM_MODEL_NAME=gemma-4-12b-local
OPENJM_MODEL_TIMEOUT_SECONDS=300
OPENJM_MODEL_PROVIDER_FALLBACK=none
OPENJM_MODEL_ALLOW_INSECURE_HTTP=true
# SECRET (injected): OPENJM_MODEL_API_KEY (server-side only)

# --- HTTP boundary / security ----------------------------------------------
OPENJM_CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
OPENJM_TRUSTED_HOSTS=127.0.0.1,localhost
OPENJM_TRUST_PROXY_HEADERS=true
OPENJM_SECURITY_HEADERS_ENABLED=true
OPENJM_RATE_LIMIT_ENABLED=true
OPENJM_RATE_LIMIT_EXPENSIVE_PER_MINUTE=60
OPENJM_METRICS_ENABLED=true
# SECRET (injected): OPENJM_OPS_TOKEN (exposes /api/metrics and /api/ready/detail)

# --- Knowledge engine ------------------------------------------------------
OPENJM_KNOWLEDGE_ENABLED=true
OPENJM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENJM_VECTOR_COLLECTION=openjm_default

# --- Structured data sandbox ------------------------------------------------
OPENJM_STRUCTURED_MAX_ROWS=200
OPENJM_STRUCTURED_TIMEOUT_SECONDS=20

# --- Scheduler -------------------------------------------------------------
OPENJM_SCHEDULER_ENABLED=true
OPENJM_SCHEDULER_TICK_SECONDS=30
OPENJM_RETENTION_ENABLED=false
